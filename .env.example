# ===========================================
# AI Smart Barbershop - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.

# ---- Deployment Profile ----
# "demo"  = QUEUE_CONNECTION=sync (Free Portfolio Mode)
# "async" = QUEUE_CONNECTION=redis (Faithful Staging / Production)
DEPLOYMENT_PROFILE=demo

# ---- Application Settings ----
APP_NAME="AI Smart Barbershop"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://api-staging.aibarber.com
FRONTEND_URL=https://demo.aibarber.com
ALLOWED_ORIGINS="https://demo.aibarber.com"

# Application Encryption Key (Generate via: php artisan key:generate)
APP_KEY=

# ---- Database (Supabase PostgreSQL) ----
DB_CONNECTION=pgsql
DB_HOST=db.kqwbxxmbbswcipecmdsw.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

# ---- Redis (Upstash / Render Key-Value) ----
# Use REDIS_URL for managed external Redis (Upstash / Render).
# When REDIS_URL is set, it takes priority over individual host/port/password.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Session & Cache & Queue ----
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
# Queue connection is automatically derived from DEPLOYMENT_PROFILE.
# Override explicitly if needed:
# QUEUE_CONNECTION=sync

# ---- Sanctum Authentication ----
SANCTUM_STATEFUL_DOMAINS="demo.aibarber.com"
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX="aib_stg_"

# ---- Reverb WebSockets ----
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=aibarber-staging
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="realtime-staging.aibarber.com"
REVERB_PORT=443
REVERB_SCHEME=https

# ---- Frontend Settings (Vercel) ----
NEXT_PUBLIC_API_URL=https://api-staging.aibarber.com/api/v1
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST="realtime-staging.aibarber.com"
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# ---- AI External Providers (Server-Side Secrets Only) ----
OPENAI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_TOKEN=

# ---- Storage (Cloudflare R2 — Private Buckets) ----
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=aibarber-staging-uploads
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AI_TEMP_IMAGE_RETENTION_HOURS=24
AI_PREVIEW_RETENTION_DAYS=7

# ---- Cron Security Token ----
CRON_SECRET_TOKEN=

# ---- Mail Settings ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@aibarber.com"
MAIL_FROM_NAME="${APP_NAME}"
